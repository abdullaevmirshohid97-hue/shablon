{
  "expo": {
    "name": "idaa finance",
    "slug": "mubosher-mobile",
    "scheme": "mubosher",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.mubosher.mobile"
    },
    "android": {
      "package": "uz.mubosher.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "81dbd672-193b-4fc0-9543-b12ff77a1ed3"
      }
    },
    "owner": "amirxon.ai4020"
  }
}
