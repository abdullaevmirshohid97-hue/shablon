{
  "expo": {
    "name": "Mubosher",
    "slug": "mubosher-mobile",
    "scheme": "mubosher",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.mubosher.mobile"
    },
    "android": {
      "package": "uz.mubosher.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite"],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
