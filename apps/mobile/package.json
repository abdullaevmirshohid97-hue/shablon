{
  "name": "@mubosher/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "expo start --tunnel",
    "dev:lan": "expo start --lan --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --config ../../packages/config/eslint.base.js && npm run lint:deps",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .expo node_modules/.cache .turbo",
    "build:apk": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:apk:local": "npx --yes eas-cli@latest build --platform android --profile preview --local",
    "build": "echo 'use npm run build:apk (EAS) — see README'",
    "lint:deps": "node ../../scripts/check-phantom-deps.mjs"
  },
  "dependencies": {
    "@mubosher/api-client": "*",
    "@mubosher/shared": "*",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~54.0.12",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@mubosher/config": "*",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
