# ============================================================================
# Mubosher web — PRODUCTION env (merycollection.uz)
# Serverda BIR MARTA `apps/web/.env.production` nomi bilan nusxa oling va
# haqiqiy qiymatlar bilan to'ldiring. Bu fayl gitignore'da — repoga tushmaydi.
#
#   cp apps/web/.env.production.example apps/web/.env.production
#
# Bu ikkala kalit ham PUBLIC (anon/publishable) — client bundle'ga baribir
# ochiq chiqadi, shuning uchun ularni bu yerda saqlash xavfsiz. MAXFIY
# (service_role) kalitni BU YERGA HECH QACHON qo'ymang.
#
# DIQQAT: bu qiymatlar `next build` paytida bundle ichiga "yopishtiriladi"
# (inlined), shuning uchun deploy.sh build'dan OLDIN bu fayl mavjudligini
# tekshiradi. O'zgartirsangiz — qayta build qilish shart.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
